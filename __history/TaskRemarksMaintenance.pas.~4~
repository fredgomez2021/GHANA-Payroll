procedure TfrmTaskRemarksMaintenance.Delete_Log( vTask_ID : String);
var
  SQL: String;
begin
  SQL :=       'INSERT INTO dtaLogFile ' ;
  SQL := SQL + '   ( Tran_Date, User_id, Module_Desc, Command, Table_Name, Field_Name, Prev_Value ) ' ;
  SQL := SQL + 'VALUES ';
  SQL := SQL + '( ';
  SQL := SQL + chr(39) + DateToStr(Now) + ' ' + TimeToStr(Now) + chr(39) + ', ';
  SQL := SQL + IntToStr(gUser_ID) + ', ';
  SQL := SQL + chr(39) + 'Task-ID Maintanance' + chr(39) + ', ';
  SQL := SQL + chr(39) + 'Delete' + chr(39) + ', ';
  SQL := SQL + chr(39) + 'dtaTaskRemarks' + chr(39) + ', ';
  SQL := SQL + chr(39) + 'Task_ID' + chr(39) + ', ';
  SQL := SQL + chr(39) + vTask_ID + chr(39);
  SQL := SQL + ')';
  ADOConnection.Execute(SQL);
end;

