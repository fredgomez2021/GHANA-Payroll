procedure TfrmTaskRemarksMaintenance.cmdAddClick(Sender: TObject);
begin
    if (txtTaskID.Text <> '') AND (txtTaskDesc.Text <> '') AND (txtFirstRate.Text <> '') then
    begin
        with ADODataSet do
        begin
            Close;
            CommandText := 'SELECT * FROM dtaTaskRemarks WHERE Task_ID = ' + Chr(39) + txtTaskID.Text + Chr(39);
            Open;

            If RecordCount > 0 then
                ShowMessage('Task ID already exists!  Please try another.')
            else
            begin
            Insert;
              FieldByName('Task_ID').AsString := txtTaskID.Text;
              FieldByName('Task_Description').AsString := txtTaskDesc.Text;
              FieldByName('Piece_Rate').AsString := txtFirstRate.Text;
              {FieldByName('Revenue_Rate').AsString := txtRevenueRate.Text;
              FieldByName('Supervisor').AsString := cmbSupervisor_PIN.Text;
              FieldByName('Team_Leader').AsString := cmbTeamLeader_PIN.Text;
              FieldByName('TimeDiff').AsString := txtTimeDiff.Text;}
            Post;

            ShowMessage('New task code was successfully added!');

            Close;

            end;
            txtTaskID.Clear;
            txtTaskDesc.Clear;
            txtFirstRate.Clear;
{            txtRevenueRate.Clear;
            cmbSupervisor.Text := '';
            cmbSupervisor_PIN.Text := '';
            cmbTeamLeader.Text := '';
            cmbTeamLeader_PIN.Text := '';
            txtTimeDiff.Clear;}

            txtTaskID.SetFocus;
          end;
    end
    else
          ShowMessage('Please verify your inputs!');
end;

