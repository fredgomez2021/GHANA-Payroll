procedure TfrmTaskRemarksMaintenance.cmdEditClick(Sender: TObject);
var
  count : integer;
begin
  if cmdEdit.Caption = '&EDIT' then
  begin

      varIdle := InputBox('Task Remarks', 'Enter Task ID',' ');

      varLen := StrLen(PChar(varIdle));

      if varLen >= 1 then
      begin

      with ADODataSet do
      begin
          Close;
          CommandText := 'SELECT * FROM dtaTaskRemarks WHERE Task_ID = ' + Chr(39) + varIdle + Chr(39);
          Open;

          //ShowMessage(IntToStr(RecordCount));
          if RecordCount > 0 then
          begin
            cmdEdit.Caption := '&SAVE';
            cmdAdd.Enabled := FALSE;
            cmdDelete.Enabled := FALSE;
            txtTaskID.Enabled := FALSE;

            Display_Data;
            //txtTaskID.SetFocus;

          end
          else
            ShowMessage('No task ID found in our database!');
//          Close;
      end;
      end
      else
        ShowMessage('Please key in a valid task id!');
  end
  else
  begin
      cmdEdit.Caption := '&EDIT';
      cmdAdd.Enabled := TRUE;
      cmdDelete.Enabled := TRUE;
      txtTaskID.Enabled := TRUE;

      with ADODataSet do
      begin

          Edit_Log;

          Edit;
//            FieldByName('Task_ID').AsString := txtTaskID.Text;
            FieldByName('Task_Description').AsString := txtTaskDesc.Text;
            {FieldByName('Piece_Rate').AsString := txtPieceRate.Text;
            FieldByName('Revenue_Rate').AsString := txtRevenueRate.Text;
            FieldByName('Supervisor').AsString := cmbSupervisor_PIN.Text;
            FieldByName('Team_Leader').AsString := cmbTeamLeader_PIN.Text;
            FieldByName('TimeDiff').AsString := txtTimeDiff.Text;}
          Post;

          ShowMessage('Record was successfully updated!');

          txtTaskID.Clear;
          txtTaskDesc.Clear;
          {txtPieceRate.Clear;
          txtRevenueRate.Clear;
          cmbSupervisor.Text := '';
          //cmbSupervisor_PIN.Text := '';
          cmbTeamLeader.Text := '';
          //cmbTeamLeader_PIN.Text := '';
          txtTimeDiff.Clear;}

      Close;
      end;
  end;
end;

procedure TfrmTaskRemarksMaintenance.cmdDeleteClick(Sender: TObject);
var
  varStr : String;
begin
      varIdle := InputBox('Task Remarks', 'Enter Task ID',' ');

      varLen := StrLen(PChar(varIdle));

      if varLen > 1 then
      begin
      with ADODataSet do
      begin
        Close;
        CommandText := 'SELECT * FROM dtaTaskRemarks WHERE Task_ID = ' + Chr(39) + varIdle + Chr(39);
        Open;

        if RecordCount > 0 then
        begin
          Display_Data;

        if MessageDlg('Delete task remark?', mtConfirmation, mbYesNo, 0) = mrYes then
          with ADOConnection do
          begin

            Delete_Log( varIdle );

            Execute('DELETE FROM dtaTaskRemarks WHERE Task_ID = ' + Chr(39) + varIdle + Chr(39));

            txtTaskID.Clear;
            txtTaskDesc.Clear;
            {txtPieceRate.Clear;
            txtRevenueRate.Clear;
            cmbSupervisor.Text := '';
            //cmbSupervisor_PIN.Text := '';
            cmbTeamLeader.Text := '';
            //cmbTeamLeader_PIN.Text := '';
            txtTimeDiff.Clear;}

            ShowMessage('Record was successfully deleted!');
          end;
        end
        else
          ShowMessage ('No Task ID found in our database!');
        Close;
      end;
    end
    else
      ShowMessage('Please key in a valid Task ID!');
end;


