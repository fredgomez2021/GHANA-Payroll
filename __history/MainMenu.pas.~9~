procedure TfrmMenu.FormShow(Sender: TObject);
var
  varAccessId : String;
  varModuleDesc : String;
begin

  vEmpId := CommonModule.ActiveUserId;
  //vEmpId := '313';

  DisableAllMenuItems();

  dsAccess.Close;
  dsAccess.Connection := ADOAccess;
  dsAccess.CommandText := 'SELECT * FROM dtaUser_Access_Rights WHERE User_ID = ' + Chr(39) + vEmpId + Chr(39);
  dsAccess.Active := TRUE;

  //ShowMessage(IntToStr(dsAccess.RecordCount));
  if dsAccess.RecordCount > 0 then
  begin
    dsAccess.First;
    while not dsAccess.Eof do
    begin
      varAccessId := dsAccess.FieldByName('Access_Id').AsString;

      dsModule.Close;
      dsModule.Connection := ADOAccess;
      dsModule.CommandText := 'SELECT * FROM dtaAccess_Rights_Codes WHERE Access_Id = ' + varAccessId;
      dsModule.Active := TRUE;

      if dsModule.RecordCount > 0 then
      begin
        varModuleDesc := dsModule.FieldByName('Program_Module').AsString;

        case StringToCaseSelect(varModuleDesc,
          ['Employee File Maintenance','Task-ID Maintenance','Idle Code Maintenance', 'Keyer-ID Maintenance', 'Holiday Maintenance',
            'Idle Time Entry', 'DTR Correction', 'Overtime Validation', 'Other Earnings/Deductions Entry', 'Log File Verification',
            'DTR Correction1', 'Overtime (No) Transaction', 'Day Off',
            'Daily Schedule Extraction', 'EDS Time Extraction', 'Production Report Extractions', 'Payroll Process', 'Employee List', 'Task List', 'Idle Code List',
            'Keyed Idle Time', 'Keyer-ID List ', 'Daily Time Record', 'Log File Report', 'Extracted Time Periods', 'Keyer Schedule', 'Payroll Summary Report', 'Payroll With ATM',
            'Payroll Cash Basis', 'Production Report Extraction Summary', 'System User Maintenance', 'Access Rights Maintenance', 'Pay Slip', 'Missing PIN',
            'ChinaTrust File Transmission', 'SSS File Transmission']) of
          0:EmployeeFileMaintenance1.Enabled := TRUE;
          1:TaskIDMaintenance1.Enabled := TRUE;
          2:IdleCodeMaintenance1.Enabled := TRUE;
          3:KeyerIDMaintenance1.Enabled := TRUE;
          4:HolidayMaintenance1.Enabled := TRUE;
          5:IdleTimeEntry1.Enabled := TRUE;
          6:DTRCorrection1.Enabled := TRUE;
          7:OvertimeValidation1.Enabled := TRUE;
          8:OtherEarningsDeductionsEntry1.Enabled := TRUE;
          9:LogFileVerification1.Enabled := TRUE;
          //10:DTRCorrection2.Enabled := TRUE;
          //11:OvertimeNoTransaction1.Enabled := TRUE;
          12:DayOffEntry1.Enabled := TRUE;
          //13:DailyScheduleExtraction1.Enabled := TRUE;
          14:EDSTimeExtraction1.Enabled := TRUE;
          15:ProductionReportExtractions1.Enabled := TRUE;
          16:PayrollProcess1.Enabled := TRUE;
          17:EmployeeList1.Enabled := TRUE;
          18:TaskList1.Enabled := TRUE;
          19:IdleCodeList1.Enabled := TRUE;
          20:KeyedIdleTime1.Enabled := TRUE;
          21:KeyerIDList1.Enabled := TRUE;
          22:DailyTimeRecord1.Enabled := TRUE;
          23:LogFileReport1.Enabled := TRUE;
          //24:ExtractedTimePeriods1.Enabled := TRUE;
          //25:KeyerSchedule1.Enabled := TRUE;
          26:PayrollSummaryReport1.Enabled := TRUE;
          //27:WithATM1.Enabled := TRUE;
          //28:Cash1.Enabled := TRUE;
          //29:ProductionReportExtractionSummary1.Enabled := TRUE;
