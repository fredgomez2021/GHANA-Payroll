unit CommonModule;

interface

uses
  SysUtils, Forms, inifiles, Dialogs, Winsock;

  function ToConnect(const ConnTo:string): string;
  function ReadInitConn(const ConnTo:string): string;
  function GetIPFromHost(var HostName, IPaddr, WSAErr: string): Boolean;

  function ReadInitConn_Snacks(const ConnTo:string): string;

var
  ActiveUserId : String;
  ActiveUserName : String;
  sVersion : String;

  //log file variables
  varUser, varModule, varCommand, varTable, varId, varFieldName : String;
  varDate, varDate1, varPIN1, varPrevValue, varNewValue, varRemarks : String;

implementation

function ToConnect(const ConnTo:string): string;
var
  IniFile : TMemIniFile;
begin
  IniFile := TMemIniFile.Create('AppIniFile.ini');
  Result := IniFile.ReadString('ToConn','strConn',ConnTo);
end;

function ReadInitConn(const ConnTo:string): string;
var
  IniFile : TMemIniFile;
  ConnTo2, strConn, sCorrectDir : string;
begin
  sCorrectDir := ExtractFilePath(ParamStr(0));
  SetCurrentDir(sCorrectDir);

  IniFile := nil;
  
  try
    if (FileExists('AppIniFile.ini')) then
    begin
      IniFile := TMemIniFile.Create('AppIniFile.ini');
      ConnTo2 := 'Conn2';

      strConn :=  'Provider=' + IniFile.ReadString(ConnTo2, 'Provider','') +
             'Password =ExactSt@r2010;' +
             'Persist Security Info=' + IniFile.ReadString(ConnTo2,'Persist Security Info','') +
             'User ID=' + IniFile.ReadString(ConnTo2,'User ID','') +
             'Initial Catalog=' + IniFile.ReadString(ConnTo2,'Initial Catalog','') +
             'Data Source=' + IniFile.ReadString(ConnTo2,'Data Source','');

      sVersion := IniFile.ReadString(ConnTo2,'Version','');
      Result := strConn;

    end;
  finally
    IniFile.Free;
  end;
end;

