procedure TfrmEmployeeFileMaintenance.LoadEmp_Loc();
begin

  dsCombo.Close;
  dsCombo.CommandText := 'SELECT * FROM dtaCodeTables WHERE Code_Category=''Emp_Loc'' ORDER BY Description';
  dsCombo.Active := TRUE;

  if dsCombo.RecordCount > 0 then
  begin
    dsCombo.First;
    cmbEmp_Loc.Clear;
    while not dsCombo.Eof do
    begin
      cmbEmp_Loc.Items.Add(dsCombo.FieldByName('Description').AsString);
      dsCombo.Next;
    end;
  end;
end;

