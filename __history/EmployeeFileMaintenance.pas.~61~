procedure TfrmEmployeeFileMaintenance.cmdAddClick(Sender: TObject);
begin
    if (txtEmployeePIN.Text <> '') AND (txtEmployeeName.Text <> '') then
    begin
        if (StrToFloat(txtMonthlyRate.Text)>0) and (StrToFloat(txtRate_Hour.Text)>0) then
        begin
          ShowMessage('Either Monthly Rate or Rate Hour must be zero (0).');
          Exit;
        end;
        varWATM := '';
        varATMNum := '';
        with ADODataSet do
        begin
            Close;
            CommandText := 'SELECT * FROM dtaEmployees WHERE Employee_PIN = ' + txtEmployeePIN.Text;
            Open;

            if RecordCount > 0 then
              ShowMessage('Employee PIN already exists! Please try another.')
            else
            begin
              Insert;
              varPIN1 := txtEmployeePIN.Text;
              varName := txtEmployeeName.Text;

              FieldByName('Employee_PIN').AsString := txtEmployeePIN.Text;
              FieldByName('Employee_Name').AsString := txtEmployeeName.Text;
              FieldByName('Emp_Loc').AsString := cmbEmp_Loc.Text;
              FieldByName('Emp_Status').AsString := cmbEmp_Status.Text;

              FieldByName('EmailAdd1').AsString := txtEmail.Text;
              
              //save job position code
              dsCombo.Close;
              dsCombo.CommandText := 'SELECT * FROM dtaCodeTables WHERE Code_Category=''Job_Position'' AND Description = ' +
                Chr(39) + cmbJobPosition.Text + Chr(39);
              dsCombo.Active := TRUE;

              if dsCombo.RecordCount > 0 then
                FieldByName('Job_Position_Code').AsString := dsCombo.FieldByName('Code').AsString;

              FieldByName('Primary_Task_ID').AsString := cmbPrimary_Task_ID.Text;
              FieldByName('Project').AsString := cmbPrimary_Task_ID.Text;

              FieldByName('ATM_Number').AsString := txtATMNumber.Text;
              FieldByName('ATMCardNumber').AsString := txtATMCardNumber.Text;

              FieldByName('Monthly_Rate').asFloat := StrToFloat(txtMonthlyRate.Text);
              FieldByName('Rate_Hour').asFloat := StrToFloat(txtRate_Hour.Text);
              FieldByName('Date_Hired').AsDateTime := dtpDate_Hired.DateTime;

              if chkIncludeInProcess.Checked then FieldByName('ProcessIncluded').AsVariant := 1
              else FieldByName('ProcessIncluded').AsVariant := 0;

              if txtMP2EmpShare.Text <> '' then
                FieldByName('MP2Share').asFloat := StrToFloat(txtMP2EmpShare.Text);

              Post;

              ShowMessage('New Employee record was successfully added!');

              Close;
            end;

            Add_Log;

            txtEmployeePIN.Clear;
            txtEmployeeName.Clear;
            txtEmployeePIN.SetFocus;
        end;
    end
    else
          ShowMessage('Please verify your inputs!');
end;

procedure TfrmEmployeeFileMaintenance.cmdEditClick(Sender: TObject);
begin
  if cmdEdit.Caption = '&EDIT' then
  begin

       varEmpPIN := InputBox('Employee Info', 'Enter Employee PIN',' ');
      //ShowMessage(varIdle);

      varLen := StrLen(PChar(varEmpPIN));

      if varLen >= 1 then
      begin

      InsertToLogFile(sTranDate, sUserID, 'Employee File Maintenance', 'Edit', 'dtaEmployees', varEmpPIN);

      with ADODataSet do
      begin

          Close;
          CommandText := 'SELECT * FROM dtaEmployees WHERE Employee_PIN = ' + Chr(39) + varEmpPIN + Chr(39);
          Active := TRUE;

          if RecordCount > 0 then
          begin
            varTask := FieldByName('Primary_Task_ID').AsString;
            varPos := FieldByName('Job_Position_Code').AsString;
          end;

          if RecordCount > 0 then
          begin
            cmdEdit.Caption := '&SAVE';
            cmdClose.Caption := '&CANCEL';
            cmdAdd.Enabled := FALSE;
            cmdDelete.Enabled := FALSE;
            txtEmployeePIN.Enabled := FALSE;

            txtEmployeePIN.Text := FieldByName('Employee_PIN').AsString;
            txtEmployeeName.Text := FieldByName('Employee_Name').AsString;

            if not FieldByName('Emp_Loc').IsNull then
              cmbEmp_Loc.Text := FieldByName('Emp_Loc').AsString;

            if not FieldByName('Emp_Status').IsNull then
              cmbEmp_Status.Text := FieldByName('Emp_Status').AsString;

            txtATMNumber.Text := FieldByName('ATM_Number').AsString;
            txtATMCardNumber.Text := FieldByName('ATMCardNumber').AsString;

            //get job position
            varPos := FieldByName('Job_Position_Code').AsString;

            dsCombo.Close;
            dsCombo.CommandText := 'SELECT * FROM dtaCodeTables WHERE code = ' + Chr(39) + varPos + Chr(39);
            dsCombo.Active := TRUE;

            if dsCombo.RecordCount > 0 then
              cmbJobPosition.Text := dsCombo.FieldByName('Description').AsString;

            cmbPrimary_Task_ID.Text := FieldByName('Primary_Task_ID').AsString;

            txtEmail.Text := FieldByName('EmailAdd1').AsString;

            txtMonthlyRate.Text := FieldByName('Monthly_Rate').asString;
            txtRate_Hour.Text := FieldByName('Rate_Hour').asString;

            dtpDate_Hired.DateTime := FieldByName('Date_Hired').AsDateTime;

            if FieldByName('ProcessIncluded').IsNull then
              chkIncludeInProcess.Checked := false
            else
            begin
              if FieldByName('ProcessIncluded').asBoolean then
                chkIncludeInProcess.Checked := true
              else
                chkIncludeInProcess.Checked := false
            end;

            if not FieldByName('MP2Share').IsNull then
              txtMP2EmpShare.Text := FieldByName('MP2Share').asString
            else
              txtMP2EmpShare.Text := '0.00';
          end
          else
            ShowMessage ('No employee record was found in our database or is on another project!');
      end;
      end
      else
        ShowMessage('Please key in a valid Employee PIN!');
  end
  else
  begin
      cmdEdit.Caption := '&EDIT';
      cmdAdd.Enabled := TRUE;
      cmdDelete.Enabled := TRUE;
      txtEmployeePIN.Enabled := TRUE;

       Edit_log;

        with ADODataSet do
        begin
          Edit;

            // * * * SAVE REST OF INFO
            FieldByName('Employee_Name').AsString := txtEmployeeName.Text;

            //save job position code
            dsCombo.Close;
            dsCombo.CommandText := 'SELECT * FROM dtaCodeTables WHERE Description = ' + Chr(39) + cmbJobPosition.Text + Chr(39);
            dsCombo.Active := TRUE;

            if dsCombo.RecordCount > 0 then
              FieldByName('Job_Position_Code').AsString := dsCombo.FieldByName('Code').AsString;
              FieldByName('Emp_Loc').AsString := cmbemp_loc.Text;
              FieldByName('Emp_Status').AsString := cmbEmp_Status.Text;

            //save primary task id
            FieldByName('Primary_Task_ID').AsString := cmbPrimary_Task_ID.Text;
            FieldByName('Project').AsString := cmbPrimary_Task_ID.Text;

            FieldByName('EmailAdd1').AsString := txtEmail.Text;

            FieldByName('ATM_Number').AsString := txtATMNumber.Text;
            FieldByName('ATMCardNumber').AsString := txtATMCardNumber.Text;

            FieldByName('Monthly_Rate').asFloat := StrToFloat(txtMonthlyRate.Text);
            FieldByName('Rate_Hour').asFloat := StrToFloat(txtRate_Hour.Text);

            FieldByName('Date_Hired').AsDateTime := dtpDate_Hired.DateTime;
            if chkIncludeInProcess.Checked then FieldByName('ProcessIncluded').AsVariant := 1
            else FieldByName('ProcessIncluded').AsVariant := 0;

            if txtMP2EmpShare.Text <> '' then
              FieldByName('MP2Share').asFloat := StrToFloat(txtMP2EmpShare.Text);

          Post;

          ShowMessage('Record was successfully updated!');
          Close;
        end;
       end;
end;

procedure TfrmEmployeeFileMaintenance.cmdDeleteClick(Sender: TObject);
begin
  varEmpPIN := InputBox('Employee Info', 'Enter Employee PIN',' ');
  varLen := StrLen(PChar(varEmpPIN));

  if varLen = 0 then
  begin
    ShowMessage('Please key in a valid Employee PIN!');
    exit;
  end;

    with ADODataSet do
    begin
      Close;
      CommandText := 'SELECT * FROM dtaEmployees WHERE Employee_PIN = ' + Chr(39) + varEmpPIN + Chr(39);
      Active := TRUE;

      if RecordCount > 0 then
      begin
        varTask := FieldByName('Primary_Task_ID').AsString;
        varPos := FieldByName('Job_Position_Code').AsString
      end
      else
      begin
        ShowMessage ('No employee record was found in our database!');
        exit
      end;

      if RecordCount > 0 then
      begin
        cmdAdd.Enabled := FALSE;
        cmdEdit.Enabled := FALSE;
        cmdDelete.Enabled := FALSE;
        txtEmployeePIN.Enabled := FALSE;

        txtEmployeePIN.Text := FieldByName('Employee_PIN').AsString;
        txtEmployeeName.Text := FieldByName('Employee_Name').AsString;

        if not FieldByName('Emp_Loc').IsNull then
          cmbEmp_Loc.Text := FieldByName('Emp_Loc').AsString;

        if not FieldByName('Emp_Status').IsNull then
          cmbEmp_Status.Text := FieldByName('Emp_Status').AsString;

        txtATMNumber.Text := FieldByName('ATM_Number').AsString;
        txtATMCardNumber.Text := FieldByName('ATMCardNumber').AsString;

        //get job position
        varPos := FieldByName('Job_Position_Code').AsString;

        dsCombo.Close;
        dsCombo.CommandText := 'SELECT * FROM dtaCodeTables WHERE code = ' + Chr(39) + varPos + Chr(39);
        dsCombo.Active := TRUE;

        if dsCombo.RecordCount > 0 then
          cmbJobPosition.Text := dsCombo.FieldByName('Description').AsString;

          cmbPrimary_Task_ID.Text := FieldByName('Primary_Task_ID').AsString;

          txtMonthlyRate.Text := FieldByName('Monthly_Rate').asString;
          txtRate_Hour.Text := FieldByName('Rate_Hour').asString;

        if MessageDlg('Delete Employee?', mtConfirmation, mbYesNo, 0) = mrYes then
        with ADOConnection do
        begin
          Delete_log;
          Execute('DELETE FROM dtaEmployees WHERE Employee_PIN = ' + varEmpPIN);
          txtEmployeePIN.Clear;
          txtEmployeeName.Clear;
          ShowMessage('Record was successfully deleted!');
        end;
        cmdAdd.Enabled := TRUE;
        cmdEdit.Enabled := TRUE;
        cmdDelete.Enabled := TRUE;
      end;
    end;
end;

