procedure TfrmEmployeeFileMaintenance.Edit_Log;
var
  SQL: String;
  varPIncluded : Boolean;
  varJob, varJobEdited : String;
  ND : String;

begin

  with ADODataSet do begin
    //Employee name
    if( FieldByName('Employee_Name').AsString <> txtEmployeeName.Text ) then
    begin
      SQL :=       'INSERT INTO dtaLogFile ' ;
      SQL := SQL + '   ( Tran_Date, User_id, Employee_PIN, Module_Desc, Command, Table_Name, Field_Name, Prev_Value, New_Value ) ' ;
      SQL := SQL + 'VALUES ';
