procedure TfrmEmployeeFileMaintenance.LoadEmp_Status();
begin
//Load tax codes
  dsCombo.Close;
  dsCombo.CommandText := 'SELECT DISTINCT Code FROM dtaCodeTables WHERE Code_Category=''Emp_STatus'' ORDER BY Code';
  dsCombo.Active := TRUE;

  if dsCombo.RecordCount > 0 then
  begin
    dsCombo.First;
    cmbEmp_Status.Clear;
    while not dsCombo.Eof do
    begin
      cmbEmp_Status.Items.Add(dsCombo.FieldByName('Code').AsString);
      dsCombo.Next;
    end;
    cmbEmp_Status.Text := 'ACTIVE';
  end;
end;

