function TfrmExtractPayrollProcess.totalcount( temp_st: string ): string;
var
  st : string;
  i : integer;
  j : integer;
begin
  temp_st := '000000' + temp_st;
  i := length(temp_st);
  j := 0;
  st := '';
  repeat
    j := j + 1;

    if( j>0 ) then
    begin
      //if copy(temp_st,i,1)<>'.' then
        st := copy(temp_st,i,1) + st;
        i := i - 1;
    end;
  until length(st)=6;
//  showmessage(st);
  totalcount := st;
end;

