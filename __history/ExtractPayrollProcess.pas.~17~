procedure TfrmExtractPayrollProcess.UpdateDateTo();
var
  dt: TDateTime;
  myYear, myMonth, myDay : Word;
begin

    //dbgrid1.Visible := true;
    DecodeDate(dpFromDate.Date, myYear, myMonth, myDay);
    
  if(DayOfTheMonth(dpFromDate.Date))=1 then
    dt := EncodeDate( myYear, myMonth, 15)
  else
    begin
      dt := EndOfAMonth( myYear, myMonth );
      DecodeDate( dt, myYear, myMonth, myDay );
      dt := EncodeDate( myYear, myMonth, myDay );
    end;

  dpDateTo.Date := dt;
  dpDateTo.Refresh;
end;

