    ADODataSet1: TADODataSet;
    GroupBox5: TGroupBox;
    txtUser: TEdit;
    GroupBox1: TGroupBox;
    Label1: TLabel;
    txtCurrentPassword: TEdit;
    Label2: TLabel;
    txtNewPassword: TEdit;
    Label3: TLabel;
    txtConfirmPassword: TEdit;
    cmdChangePassword: TButton;
    Label4: TLabel;
    txtText: TEdit;
    Label12: TLabel;
    Label7: TLabel;
    Label5: TLabel;
    txtResult: TEdit;
    btnEncrypt: TButton;
    btnDecrypt: TButton;
    procedure FormShow(Sender: TObject);
    procedure btnDecryptClick(Sender: TObject);
    procedure btnEncryptClick(Sender: TObject);
    procedure Label4Click(Sender: TObject);
    procedure FormActivate(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure cmdChangePasswordClick(Sender: TObject);
    procedure FormCreate(Sender: TObject);
  private
    { Private declarations }
  public
    function Encrypt(const S: String): String;
    function Decrypt(const S: String): String;
  end;

var
  frmChangePassword: TfrmChangePassword;
  gUser : String;

implementation

{$R *.dfm}

procedure TfrmChangePassword.FormCreate(Sender: TObject);
begin
  ADOConnection1.ConnectionString := CommonModule.ReadInitConn(CommonModule.ToConnect('Null'));
  ADOConnection1.Connected := TRUE;

  //frmChangePassword.Height := 229;
end;

procedure TfrmChangePassword.cmdChangePasswordClick(Sender: TObject);
var
  sCurrentPassword : string;
  sPassword : string;
  sNewPassword : string;
  sConfirmPassword : string;
  sMsg, sql : string;
begin
  // make sure all fields are field out
  sCurrentPassword := txtCurrentPassword.Text;
  sNewPassword := txtNewPassword.Text;
  sConfirmPassword := txtConfirmPassword.Text;

  // all fields are required
  if (sCurrentPassword <> '') and (sNewPassword <> '') and (sConfirmPassword <> '') then
  begin
    // get current password from dtaUsers
    ADODataSet1.Close;
    ADODataSet1.CommandText := 'SELECT [Password] ' +
      'FROM [dtaUsers] ' +
      'WHERE [Username] = ''' + txtUser.Text + ''' ';
    ADODataSet1.Active := TRUE;
    if ADODataSet1.RecordCount > 0 then
    begin
      sPassword := ADODataSet1.FieldByName('Password').AsString;
    end;

    if sPassword <> '' then
    begin
      // encrypt keyed current password
      sCurrentPassword := Encrypt(sCurrentPassword);

      // compare existing password and keyed password
      if sCurrentPassword = sPassword then
      begin
        // make sure current password is not the same as new password
        if sPassword <> Encrypt(sNewPassword) then
        begin
          // compare if new and confirm passwords are matched
          if sNewPassword = sConfirmPassword then
          begin
            // encrypt new password
            sNewPassword := Encrypt(sNewPassword);

            // update password in dtaUsers
            sql := 'UPDATE [dtaUsers] ' +
              'SET [Password] = ''' + sNewPassword + ''' ' +
              'WHERE [UserName] = ''' + txtUser.Text + ''' ';
            ADOConnection1.Execute(sql);

            sMsg := 'Password has been successfully changed!';
            ShowMessage(sMsg);
          end
          else
          begin
            sMsg := 'New and confirm password must match!';
            ShowMessage(sMsg);
            txtNewPassword.SetFocus;
          end;  // if sNewPassword = sConfirmPassword then
        end
        else
        begin
          sMsg := 'New password must not be the same as current password!';
          ShowMessage(sMsg);
          txtNewPassword.SetFocus;
        end // if sPassword <> sNewPassword then
      end
      else
      begin
        sMsg := 'Current password entered is incorrect!';
        ShowMessage(sMsg);
        txtCurrentPassword.SetFocus;
      end; // if sCurrentPassword = sPassword then
    end;

  end
  else
  begin
    sMsg := 'All fields are required!';
    ShowMessage(sMsg);
    txtCurrentPassword.SetFocus;
  end

end;

procedure TfrmChangePassword.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  Action := caFree;
end;

procedure TfrmChangePassword.FormActivate(Sender: TObject);
begin
  gUser := ActiveUserName;  // this is only temporary and must be modified

  txtUser.Text := gUser;
end;

function TfrmChangePassword.Decrypt(const S: String): String;
var
  I: byte;
  Key: Word;
  ls : string;
const
  {C1 y C2 aon usadas para encriptar la cadena de la clave}
  C1 = 52845;
  C2 = 11719;
begin
  Key := 1674;
  SetLength(ls,Length(S) div 2);
  SetLength(Result,Length(ls));
  for I := 1 to Length(ls) do begin
    ls[I] := char(StrToInt('$'+ Copy(S, (I*2)-1 , 2)));
  end;

  for I := 1 to Length(ls) do begin
    Result[I] := char(byte(ls[I]) xor (Key shr 8));
    Key := (byte(ls[I]) + Key) * C1 + C2;
  end;
end;

function TfrmChangePassword.Encrypt(const S: String): String;
var
  I: byte;
  Key: Word;
  ls : string;
const
  {C1 y C2 aon usadas para encriptar la cadena de la clave}
  C1 = 52845;
  C2 = 11719;
begin
  Key := 1674;
  SetLength(ls,Length(S));
  Result := '';
  for I := 1 to Length(S) do begin
    ls[I] := char(byte(S[I]) xor (Key shr 8));
    Result := Result + IntToHex(byte(ls[I]),2);
    Key := (byte(ls[I]) + Key) * C1 + C2;
  end;

end;

procedure TfrmChangePassword.Label4Click(Sender: TObject);
begin
  frmChangePassword.Height := 347;
end;

procedure TfrmChangePassword.btnEncryptClick(Sender: TObject);
begin
  if txtText.Text <> '' then
  begin
    txtResult.Text := Encrypt(txtText.Text);
  end;
end;

procedure TfrmChangePassword.btnDecryptClick(Sender: TObject);
begin
  if txtText.Text <> '' then
  begin
    txtResult.Text := Decrypt(txtText.Text);
  end;
end;

end.
