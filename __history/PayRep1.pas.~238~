procedure TfrmPayRep1.UpdateDateTo();
var
  dt: TDateTime;
  myYear, myMonth, myDay : Word;
begin
  DecodeDate(DateTimePicker1.Date, myYear, myMonth, myDay);

  dt := EncodeDate( myYear, myMonth + 1, 20);

  {if(DayOfTheMonth(DateTimePicker1.Date))=1 then
    dt := EncodeDate( myYear, myMonth, 15)
  else
    begin
      dt := EndOfAMonth( myYear, myMonth );
      DecodeDate( dt, myYear, myMonth, myDay );
      dt := EncodeDate( myYear, myMonth, myDay );
    end;}
    
  DateTimePicker2.Date := dt;
  DateTimePicker2.Refresh;
end;

procedure TfrmPayRep1.FormActivate(Sender: TObject);
begin
  DateTimePicker1.Date := Today;
  gUser := ActiveUserName;  // this is only temporary and must be modified
  gUser_ID := StrToInt(ActiveUserID);    // this is only temporary

  FillBranchCombo;

  UpdateDateTo();
end;

procedure TfrmPayRep1.FillBranchCombo();
var
  varBranch : String;
begin
  dsFillBranch.Close;
  dsFillBranch.CommandText := 'SELECT DISTINCT primary_task_id FROM dtaEmployees ' +
    'WHERE emp_status = ''active'' AND primary_task_id <> ''ADMIN'' ORDER BY primary_task_id';
  dsFillBranch.Connection := ADOConnection1;
  dsFillBranch.Active := TRUE;

  cboProject.Clear;
  if dsFillBranch.RecordCount > 0 then
  begin
    dsFillBranch.First;
    while not dsFillBranch.Eof do
    begin
      varBranch := dsFillBranch.FieldByName('primary_task_id').AsString;

      cboProject.AddItem(varBranch, cboProject);

      dsFillBranch.Next;
    end;
  end;
end;

