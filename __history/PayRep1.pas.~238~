begin

    dt := DateTimePicker1.Date;
    dtPeriod1 := dt;

    monthName := FormatDateTime('mmmm',dt);
    monthNum := FormatDateTime('MM',dt);
    sYear := FormatDateTime('yyyy',dt);
    
    day := DayOfTheMonth(dt);
