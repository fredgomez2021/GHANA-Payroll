    begin
      ShowMessage('The Period From should be 21st of the month.');
      DateTimePicker1.SetFocus;
      exit;
    end;

    sPeriod1 := chr(39)+DateToStr(DateTimePicker1.Date)+chr(39);
    sPeriod2 := chr(39)+DateToStr(DateTimePicker2.Date)+chr(39);
    tPeriod1 := chr(39)+DateToStr(DateTimePicker1.Date)+' 00:00:00AM' + chr(39);
    tPeriod2 := chr(39)+DateToStr(DateTimePicker2.Date)+' 23:59:00PM' + chr(39);

    ADODATASET1.Close;
    ADODATASET1.Connection := ADOCONNECTION1;
    ADODATASET1.CommandText := 'Select distinct period1 from dtaPayrollProcess where Period1='+sPeriod2;
    ADODATASET1.Open;
    I := ADODataSet1.RecordCount;
    ADODataSet1.Close;
    if I = 0 then
    begin
      ShowMessage('Payroll Period does not have data on file.');
      exit;
    end;


    {if day = 21 then
    begin
      if Length(sPeriod1) = 10 then
        sPeriod2 := chr(39)+'1/20/'+AnsiMidStr(sPeriod1,6,4)+chr(39)
      else if Length(sPeriod1) = 11 then
        sPeriod2 := chr(39)+'1/20/'+AnsiMidStr(sPeriod1,7,4)+chr(39);

      if StrToInt(monthNum) = 1 then
      begin
        sTempPrevPeriod := chr(39) + '12/21/' + IntToStr(StrToInt(sYear) - 1) + chr(39);
      end
      else
      begin
        sTempPrevPeriod := chr(39) + IntToStr(StrToInt(monthNum) - 1) + '/21/' + IntToStr(StrToInt(sYear)) + chr(39);
      end;

    end
    else
    begin
      if Length(sPeriod1) = 11 then
        sPeriod2 := chr(39)+'1/20/'+AnsiMidStr(sPeriod1,7,4)+chr(39)
      else if Length(sPeriod1) = 12 then
        sPeriod2 := chr(39)+'1/20/'+AnsiMidStr(sPeriod1,8,4)+chr(39);

      // get previous cutoff period
      sTempPrevPeriod := chr(39) + IntToStr(StrToInt(monthNum)) + '/21/' + IntToStr(StrToInt(sYear)) + chr(39);
    end;}


    vSQL := 'EXEC PayRep1 '+sPeriod1+','+sPeriod2;

    ADOConnection1.Execute(vSQL);

    oxl := CreateOleObject('Excel.Application');
    owb := oxl.workbooks.add();

    owb.Worksheets.Add();
    owb.Worksheets.Add();
    //owb.Worksheets.Add();
    //owb.Worksheets.Add();
    //owb.Worksheets.Add();
    //owb.Worksheets.Add();

    //owb.saveas('c:\omar.xls');
    osheet := owb.Sheets[1];
    osheet.Name := 'Payroll Details';

    //if MessageDlg('The selected pay period has been proceed, do you want to re-process',mtConfirmation,[mbYes,mbNo],0) = mrNo then
    //savedialog1.execute();
    //label1.Caption := savedialog1.FileName;

    if (cboProject.Text <> '') then
      ADODATASET1.CommandText := 'SELECT * FROM xPayRep1 WHERE primary_task_id = ''' +
        cboProject.Text + ''''
    else
      ADODATASET1.CommandText := 'SELECT * FROM xPayRep1';

    ADODATASET1.Open;


    row := 1;
    oSheet.Cells[row,1] := 'Payroll Period';
    oSheet.Cells[row,2] := DateToStr(DateTimePicker1.Date) + ' - ' + DateToStr(DateTimePicker2.Date);
    row := 3;
    oSheet.Cells[row,1] := 'Employee Name';
    oSheet.Cells[row,2] := 'Department';
    oSheet.Cells[row,3] := 'Job Position Code';
    oSheet.Cells[row,4] := 'Employee PIN';
    oSheet.Cells[row,5] := 'Basic Pay';
    oSheet.Cells[row,6] := 'Basic Salary Adjustment';
    oSheet.Cells[row,7] := 'Other Earnings Bef. Tax';
    oSheet.Cells[row,8] := 'Adjustment in Basic Pay';
    oSheet.Cells[row,9] := 'Other Earnings After Tax';
    oSheet.Cells[row,10] := 'Other Earnings After Tax';
    oSheet.Cells[row,11] := 'UPH Bonus';
    oSheet.Cells[row,12] := 'Quality Bonus';
    oSheet.Cells[row,13] := 'Retention Bonus';
    oSheet.Cells[row,14] := 'Other Bonus';
    oSheet.Cells[row,15] := 'FreeField Bonus';

    oSheet.Cells[row,16] := 'Gross Pay';
    oSheet.Cells[row,17] := 'With Tax';
    oSheet.Cells[row,18] := 'Total Ded';
    oSheet.Cells[row,19] := 'Net Pay';
    oSheet.Cells[row,20] := 'SSS EE';
    oSheet.Cells[row,21] := 'SSS ER';
    oSheet.Cells[row,22] := 'TIER EE';
    oSheet.Cells[row,23] := 'TIER ER';
    oSheet.Cells[row,24] := 'Total Payroll Expense';
    oSheet.Cells[row,25] := 'Hire Date Grouping';

    oSheet.Cells[row,26] := 'Email';
    oSheet.Cells[row,27] := 'GH Card No.';

    oSheet.Cells[row,28] := 'Account Number';
    oSheet.Cells[row,29] := 'Name on Account';
    oSheet.Cells[row,30] := 'Bank Name';
    oSheet.Cells[row,31] := 'Bank Branch';

    row := 4;


    //get average
    ADODataSet2.Close;
    ADODataSet2.CommandText := 'SELECT AVG(tPay_Exp) AS Average FROM xPayRep1 WHERE Primary_Task_ID <> ''ADMIN''' +
        ' AND Primary_Task_ID <> ''FINANCIAL''';
    ADODataSet2.Open;

    varAve := ADODataSet2.FieldByName('Average').AsString;


    repeat

      // get employee email
      ADODataSet2.Close;
      ADODataSet2.CommandText := 'SELECT ISNULL(EmailAdd1,'''') AS EmpEmail, Date_Hired, GhCardNumber, ATM_Number, NameOnAccount, BankName, BankBranch ' +
        'FROM dtaEmployees ' +
        'WHERE Emp_Status = ''ACTIVE'' ' +
        'AND ProcessIncluded = 1 ' +
        'AND Employee_PIN = ' + AdoDataSet1.FieldByName('Employee_PIN').AsString;

      ADODataSet2.Open;

      Edit2.Text := ADODATASET1.FieldByName('Employee_Name').AsString;
      Edit2.Refresh;
      oSheet.Cells[row,1] := AdoDataSet1.FieldByName('Employee_Name').AsString;
      oSheet.Cells[row,2] := AdoDataSet1.FieldByName('Primary_Task_ID').AsString;
      oSheet.Cells[row,3] := AdoDataSet1.FieldByName('Job_Position_Code').AsString;
      oSheet.Cells[row,4] := AdoDataSet1.FieldByName('Employee_PIN').AsString;
      oSheet.Cells[row,5] := AdoDataSet1.FieldByName('Basic_Pay').AsString;
      oSheet.Cells[row,6] := AdoDataSet1.FieldByName('Other_Earn_Amount1').AsString;
      oSheet.Cells[row,7] := AdoDataSet1.FieldByName('Other_Earn_Bef_Tax').AsString;
      oSheet.Cells[row,8] := AdoDataSet1.FieldByName('Other_Ded_Bef_Tax').AsString;
      oSheet.Cells[row,9] := AdoDataSet1.FieldByName('Other_Earn_After_Tax').AsString;
      oSheet.Cells[row,10] := AdoDataSet1.FieldByName('Other_Ded_After_Tax').AsString;
      oSheet.Cells[row,11] := AdoDataSet1.FieldByName('Bonus_UPH').AsString;
      oSheet.Cells[row,12] := AdoDataSet1.FieldByName('Bonus_Quality').AsString;
      oSheet.Cells[row,13] := AdoDataSet1.FieldByName('Bonus_Retention').AsString;
      oSheet.Cells[row,14] := AdoDataSet1.FieldByName('Bonus_Others').AsString;
      oSheet.Cells[row,15] := AdoDataSet1.FieldByName('Bonus_FreeField1').AsString;
      oSheet.Cells[row,16] := AdoDataSet1.FieldByName('Gross_Pay').AsString;
      oSheet.Cells[row,17] := AdoDataSet1.FieldByName('With_Tax').AsString;

      oSheet.Cells[row,18] := AdoDataSet1.FieldByName('Total_Ded').AsString;
      oSheet.Cells[row,19] := AdoDataSet1.FieldByName('Net_Pay').AsString;
      oSheet.Cells[row,20] := AdoDataSet1.FieldByName('SSS_EE').AsString;
      oSheet.Cells[row,21] := AdoDataSet1.FieldByName('SSS_ER').AsString;
      oSheet.Cells[row,22] := AdoDataSet1.FieldByName('MP2_EE').AsString;
      oSheet.Cells[row,23] := AdoDataSet1.FieldByName('MP2_ER').AsString;
      oSheet.Cells[row,24] := AdoDataSet1.FieldByName('TPay_Exp').AsString;

      // get hired date
      dtDateHired := StrToDateTime(ADODataSet2.FieldByName('Date_Hired').AsString);

      iDateHiredDays := DaysBetween(dtPeriod1, dtDateHired);
      if iDateHiredDays <= 30 then
      begin
        sDateHiredGrouping := 'Less and equal 30 days';
      end
      else if iDateHiredDays <= 60 then
      begin
        sDateHiredGrouping := 'Less and equal 60 days';
      end
      else if iDateHiredDays <= 90 then
      begin
        sDateHiredGrouping := 'Less and equal 90 days';
      end
      else
      begin
        sDateHiredGrouping := 'More than 90 days';
      end;

      oSheet.Cells[row,25] := sDateHiredGrouping;
      

      // set background color to green
      // total payroll expense
      oSheet.Range['BB'+IntToStr(row)+':BB'+IntToStr(row)].Interior.Color := clLIME;

      //oSheet.Cells[row,56] := StrToFloat(ADODataSet1.FieldByName('hrsWorked').AsString);

      // show employee email
      oSheet.Cells[row,26] := ADODataSet2.FieldByName('EmpEmail').AsString;
      oSheet.Cells[row,27] := ADODataSet2.FieldByName('GhCardNumber').AsString;

      oSheet.Cells[row,28] := ADODataSet2.FieldByName('ATM_Number').AsString;
      oSheet.Cells[row,29] := ADODataSet2.FieldByName('NameOnAccount').AsString;
      oSheet.Cells[row,30] := ADODataSet2.FieldByName('BankName').AsString;
      oSheet.Cells[row,31] := ADODataSet2.FieldByName('BankBranch').AsString;


      row := row + 1;

      ADODATASET1.Next;
    until ADODATASET1.Eof;

    ADODataSet2.Close;
    ADODATASET1.Close;

    oSheet.Cells[row+1,4] := 'Totals';
    oSheet.Cells[row+1,5] := '=SUM(E4:E' + IntToStr(row) + ')';
    oSheet.Cells[row+1,6] := '=SUM(F4:F' + IntToStr(row) + ')';
    oSheet.Cells[row+1,7] := '=SUM(G4:G' + IntToStr(row) + ')';
    oSheet.Cells[row+1,8] := '=SUM(H4:H' + IntToStr(row) + ')';
    oSheet.Cells[row+1,9] := '=SUM(I4:I' + IntToStr(row) + ')';
    oSheet.Cells[row+1,10] := '=SUM(J4:J' + IntToStr(row) + ')';
    oSheet.Cells[row+1,11] := '=SUM(K4:K' + IntToStr(row) + ')';
    oSheet.Cells[row+1,12] := '=SUM(L4:L' + IntToStr(row) + ')';
    oSheet.Cells[row+1,13] := '=SUM(M4:M' + IntToStr(row) + ')';
    oSheet.Cells[row+1,14] := '=SUM(N4:N' + IntToStr(row) + ')';
    oSheet.Cells[row+1,15] := '=SUM(O4:O' + IntToStr(row) + ')';
    oSheet.Cells[row+1,16] := '=SUM(P4:P' + IntToStr(row) + ')'; // gross
    oSheet.Cells[row+1,17] := '=SUM(Q4:Q' + IntToStr(row) + ')'; // tax
    oSheet.Cells[row+1,18] := '=SUM(R4:R' + IntToStr(row) + ')'; // total ded
    oSheet.Cells[row+1,19] := '=SUM(S4:S' + IntToStr(row) + ')'; // net pay
    oSheet.Cells[row+1,20] := '=SUM(T4:T' + IntToStr(row) + ')'; // SSS EE
    oSheet.Cells[row+1,21] := '=SUM(U4:U' + IntToStr(row) + ')'; // SSS ER
    oSheet.Cells[row+1,22] := '=SUM(V4:V' + IntToStr(row) + ')'; //TIER EE
    oSheet.Cells[row+1,23] := '=SUM(W4:W' + IntToStr(row) + ')'; //TIER ER
    oSheet.Cells[row+1,24] := '=SUM(X4:X' + IntToStr(row) + ')';

    // FORMATTING //
    // basic pay - net pay
    oSheet.Columns['F:W'].Style := 'Comma';
    // sss er - percentage
    //oSheet.Columns['AS:BC'].Style := 'Comma';
    // other earnings before tax
    oSheet.Columns['F:F'].NumberFormat := '_(* #,##0.00_);[Red]_(* (#,##0.00);_(* ""-""??_);_(@_)';
    // payroll period cut off header
    oSheet.Range['A1:B1'].Font.Bold := true;
    // header
    oSheet.Range['A3:Z3'].Font.Bold := true;
    // total amount
    oSheet.Range['E'+IntToStr(row+1)+':W'+IntToStr(row+1)].Font.Bold := true;
    // all columns
    oSheet.Columns['A:Z'].AutoFit;

    // set background color to green
    // total payroll expense
    oSheet.Range['W'+IntToStr(row+1)+':W'+IntToStr(row+1)].Interior.Color := clLIME;


    //write average at the bottom of total (rows)
    ADODATASET1.CommandText := 'SELECT AVG(tPay_Exp) AS Average FROM xPayRep1 WHERE Primary_Task_ID <> ''ADMIN''' +
        ' AND Primary_Task_ID <> ''FINANCIAL''';
    ADODATASET1.Open;

    // average
    oSheet.Cells[row + 3,23] := 'Average';
    oSheet.Cells[row + 3,24] := ADODATASET1.FieldByName('Average').AsString;

    ADODATASET1.Close;




    // Summary Report 1 //
    osheet := owb.Sheets[2];
    osheet.Name := 'Payroll Summary Per Project';

    if (cboProject.Text <> '') then
      ADODATASET1.CommandText := 'SELECT * FROM xPayRep2 WHERE primary_task_id = ''' +
        cboProject.Text + ''''
    else
      ADODATASET1.CommandText := 'SELECT * FROM xPayRep2';

    ADODATASET1.Open;


    row := 1;
    oSheet.Cells[row,1] := 'Payroll Period';
    oSheet.Cells[row,2] := DateToStr(DateTimePicker1.Date) + ' - ' + DateToStr(DateTimePicker2.Date);
    row := 3;
    oSheet.Cells[row,1] := 'Primary Task ID';
    oSheet.Cells[row,2] := 'Basic Pay';
    oSheet.Cells[row,3] := 'Basic Salary Adjustment';
    oSheet.Cells[row,4] := 'Other Earnings Bef. Tax';
    oSheet.Cells[row,5] := 'Adjustment in Basic Pay';
    oSheet.Cells[row,6] := 'Other Earnings After Tax';
    oSheet.Cells[row,7] := 'Other Deductions After Tax';
    oSheet.Cells[row,8] := 'UPH Bonus';
    oSheet.Cells[row,9] := 'Quality Bonus';
    oSheet.Cells[row,10] := 'Retention Bonus';
    oSheet.Cells[row,11] := 'Other Bonus';
    oSheet.Cells[row,12] := 'FreeField Bonus';
    oSheet.Cells[row,13] := 'Gross Pay';
    oSheet.Cells[row,14] := 'With Tax';
    oSheet.Cells[row,15] := 'Total Ded';
    oSheet.Cells[row,16] := 'Net Pay';

    oSheet.Cells[row,17] := 'SSS EE';
    oSheet.Cells[row,18] := 'SSS ER';
    oSheet.Cells[row,19] := 'MP2 EE';
    oSheet.Cells[row,20] := 'MP2 ER';
    oSheet.Cells[row,21] := 'Total Payroll Expense';
    oSheet.Cells[row,22] := 'No. of Employees';
    oSheet.Cells[row,23] := 'Avg. Pay per Hour';
    oSheet.Cells[row,24] := 'Average';
    oSheet.Cells[row,25] := 'Percentage';

    row := 4;

    //get average
    ADODataSet2.Close;
    ADODataSet2.CommandText := 'SELECT AVG(tPay_Exp/No_Emp) AS Average FROM xPayRep2 WHERE Primary_Task_ID <> ''ADMIN''' +
        ' AND Primary_Task_ID <> ''FINANCIAL''';
    ADODataSet2.Open;

    varAve := ADODataSet2.FieldByName('Average').AsString;


    repeat

      ADODataSet2.Close;
      ADODataSet2.CommandText := 'SELECT SUM(a.Regular_hours + a.OT) AS tTime ' +
        'FROM dtaTime_Summary a LEFT OUTER JOIN dtaEmployees b ON a.employee_pin = b.employee_pin ' +
        'WHERE a.work_date BETWEEN ''' + DateToStr(DateTimePicker1.Date) + ''' AND ''' +
          DateToStr(DateTimePicker2.Date) + ''' ' +
        'AND b.primary_task_ID = ''' +ADODataSet1.FieldByName('Primary_task_id').AsString + ''' ' +
        'AND b.emp_loc = ''' +ADODataSet1.FieldByName('emp_loc').AsString + ''' ';

      ADODataSet2.Open;


      Edit2.Text := ADODATASET1.FieldByName('Primary_Task_ID').AsString;
      Edit2.Refresh;

      oSheet.Cells[row,1] := AdoDataSet1.FieldByName('Primary_Task_ID').AsString;
      oSheet.Cells[row,2] := AdoDataSet1.FieldByName('Basic_Pay').AsString;
      oSheet.Cells[row,3] := AdoDataSet1.FieldByName('Other_Earn_Amount1').AsString;
      oSheet.Cells[row,4] := AdoDataSet1.FieldByName('Other_Earn_Bef_Tax').AsString;
      oSheet.Cells[row,5] := AdoDataSet1.FieldByName('Other_Ded_Bef_Tax').AsString;
      oSheet.Cells[row,6] := AdoDataSet1.FieldByName('Other_Earn_After_Tax').AsString;
      oSheet.Cells[row,7] := AdoDataSet1.FieldByName('Other_Ded_After_Tax').AsString;
      oSheet.Cells[row,8] := AdoDataSet1.FieldByName('Bonus_UPH').AsString;
      oSheet.Cells[row,9] := AdoDataSet1.FieldByName('Bonus_Quality').AsString;
      oSheet.Cells[row,10] := AdoDataSet1.FieldByName('Bonus_Retention').AsString;
      oSheet.Cells[row,11] := AdoDataSet1.FieldByName('Bonus_Others').AsString;
      oSheet.Cells[row,12] := AdoDataSet1.FieldByName('Bonus_FreeField1').AsString;
      oSheet.Cells[row,13] := AdoDataSet1.FieldByName('Gross_Pay').AsString;
      oSheet.Cells[row,14] := AdoDataSet1.FieldByName('With_Tax').AsString;
      oSheet.Cells[row,15] := AdoDataSet1.FieldByName('Total_Ded').AsString;
      oSheet.Cells[row,16] := AdoDataSet1.FieldByName('Net_Pay').AsString;

      oSheet.Cells[row,17] := AdoDataSet1.FieldByName('SSS_EE').AsString;
      oSheet.Cells[row,18] := AdoDataSet1.FieldByName('SSS_ER').AsString;
      oSheet.Cells[row,19] := AdoDataSet1.FieldByName('MP2_EE').AsString;
      oSheet.Cells[row,20] := AdoDataSet1.FieldByName('MP2_ER').AsString;
      oSheet.Cells[row,21] := AdoDataSet1.FieldByName('TPay_Exp').AsString;
      oSheet.Cells[row,22] := AdoDataSet1.FieldByName('no_emp').AsString;


      if (ADODataSet1.FieldByName('hrsWorked').Value > 0) then
      begin
        // Avg. Pay per Hour
        oSheet.Cells[row,23] := FloatToStr(AdoDataSet1.FieldByName('TPay_Exp').Value /
          ADODataSet1.FieldByName('hrsWorked').Value);
      end
      else if (AdoDataSet1.FieldByName('Primary_Task_ID').AsString = 'ADMIN') then
      begin
        // Avg. Pay per Hour
        oSheet.Cells[row,24] := FloatToStr(AdoDataSet1.FieldByName('TPay_Exp').Value /
          (AdoDataSet1.FieldByName('no_emp').Value * 86));
      end;


      //write average and percentage
      //test primary task id if it is not 'admin' or 'financial'
      if ((AdoDataSet1.FieldByName('Primary_Task_ID').AsString <> 'ADMIN') AND (AdoDataSet1.FieldByName('Primary_Task_ID').AsString <> 'FINANCIAL')) then
      begin
          // percentage
          oSheet.Columns['AZ:AZ'].NumberFormat := '0.00%';
          // average / percentage
          oSheet.Cells[row,24] := StrToFloat(ADODataSet1.FieldByName('TPay_Exp').AsString) / StrToFloat(ADODataSet1.FieldByName('No_Emp').AsString);
          oSheet.Cells[row,25] := StrToFloat(ADODataSet1.FieldByName('TPay_Exp').AsString) / StrToFloat(ADODataSet1.FieldByName('No_Emp').AsString) / StrToFloat(varAve);
      end;

      // write down the hours worked
      // 86 is average hour per pay period
      if (AdoDataSet1.FieldByName('Primary_Task_ID').AsString = 'ADMIN') then
        oSheet.Cells[row,25] := FloatToStr(AdoDataSet1.FieldByName('no_emp').Value * 86)
      else
        oSheet.Cells[row,25] := StrToFloat(ADODataSet1.FieldByName('hrsWorked').AsString);


      if (AdoDataSet1.FieldByName('Primary_Task_ID').AsString = 'ADMIN') then
      begin

        // set background color to green
        // payroll total expense
        oSheet.Range['W'+IntToStr(row)+':W'+IntToStr(row)].Interior.Color := clYELLOW;

        row := row + 2;
      end
      else
      begin

        // set background color to green
        // payroll total expense
        oSheet.Range['W'+IntToStr(row)+':S'+IntToStr(row)].Interior.Color := clLIME;

        row := row + 1;
      end;

      ADODATASET1.Next;

    until ADODATASET1.Eof;
    ADODATASET1.Close;

    oSheet.Cells[row+1,2] := 'Totals';
    // basic pay -  no. of employees
    oSheet.Cells[row+1,2] := '=SUM(B6:B' + IntToStr(row) + ')';
