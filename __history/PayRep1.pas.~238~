   oxl, owb, osheet : variant;
   keyer: word;
   Tem : String;
   vKeyer_ID: String;
   vExtracted_Date : String;
   vProcessed: string;
   vTask_ID : string;
   vBatches : Integer;
   vClaims : Integer;
