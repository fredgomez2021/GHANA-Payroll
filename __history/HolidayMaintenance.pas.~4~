procedure TfrmHolidayMaintenance.Grid_Load;
begin
    ADODataSet1.Close;
    ADODataSet1.CommandText := 'SELECT [Hdate], [Description], Period1, [Holiday_Type]' +
                                ' FROM [dtaHoliday_Details]' +
                                ' where [Hdate] between ' + Chr(39) +  DateToStr(dtDate1.Date) + Chr(39) +
                                ' and ' + Chr(39) +  DateToStr(dtDate2.Date) + Chr(39)  +
                                ' order by [Hdate]';

    ADODataSet1.Open;

    if ADODATASET1.RecordCount > 0 then
    begin
        DataSource1.DataSet := ADODataSet1;
        DBGrid1.DataSource := DataSource1;
        DBGrid1.Refresh;
        GenPeriod1;
    end
    else
      messagedlg('No Record Found', mtConfirmation, mbOKcancel,0);
end;

