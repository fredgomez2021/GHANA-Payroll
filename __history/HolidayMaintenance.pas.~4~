procedure TfrmHolidayMaintenance.cmdCancelClick(Sender: TObject);
begin
  if cmdCancel.Caption = 'Cancel' then
  begin
    cmdSave.Caption := '&Edit';
    cmdCancel.Caption := '&Delete';

    TDate.Text   := '';
    txtHolidayDesc.Text   := '';
    cmbHolidayType.Text := '';
  end
  else
  begin
    tFunction :='Delete Holiday';

    TDate.Text   := ADODataSet1.FieldByName('Hdate').AsString;
    cmbHolidayType.Text := ADODataSet1.FieldByName('Holiday_Type').AsString;
    txtHolidayDesc.Text   := ADODataSet1.FieldByName('Description').AsString;

    if messagedlg('Delete this record?', mtConfirmation, mbOKcancel, 0) = mrOK then
    begin
      tField :='HDate';
      GenLog(IntToStr(gUser_ID), tModDesc, tFunction , tTableName, tField, TDate.Text);
      tField :='Desciption';
      GenLog(IntToStr(gUser_ID), tModDesc, tFunction, tTableName, tField, txtHolidayDesc.Text);
      tField :='Holiday_Type';
      GenLog(IntToStr(gUser_ID), tModDesc, tFunction, tTableName, tField, cmbHolidayType.Text);

      ADODataSet1.Delete;
    end;

    TDate.Text := '';
    txtHolidayDesc.Text := '';
    cmbHolidayType.Text := '';

    GenPeriod1;
  end;
end;

procedure TfrmHolidayMaintenance.GenLog(tUserId,
