procedure TfrmHolidayMaintenance.FormShow(Sender: TObject);
var
  varAccessId : String;
  varModuleDesc : String;

  wYear, wMonth, wDay: Word;
begin

  //ClearAll();
  cmdSave.Caption := '&Edit';

  cmdAdd.Enabled := FALSE;
  cmdSave.Enabled := FALSE;
  cmdCancel.Enabled := FALSE;

  gUser_ID := StrToInt(ActiveUserId);

  sTranDate := DateToStr(Now) + ' ' + TimeToStr(Now);
  sUserID := IntToStr(gUser_ID);


  dsAccess.Close;
  dsAccess.Connection := ADOConnection1;
  dsAccess.CommandText := 'SELECT * FROM dtaUser_Access_Rights WHERE User_ID = ' + Chr(39) + IntToStr(gUser_ID) + Chr(39);
  dsAccess.Active := TRUE;

  //ShowMessage(IntToStr(dsAccess.RecordCount));
  if dsAccess.RecordCount > 0 then
  begin
    dsAccess.First;
    while not dsAccess.Eof do
    begin
      varAccessId := dsAccess.FieldByName('Access_Id').AsString;

      dsModule.Close;
      dsModule.Connection := ADOConnection1;
      dsModule.CommandText := 'SELECT * FROM dtaAccess_Rights_Codes WHERE Access_Id = ' + varAccessId;
      dsModule.Active := TRUE;

      if dsModule.RecordCount > 0 then
      begin
        varModuleDesc := dsModule.FieldByName('Program_Module').AsString;

        case StringToCaseSelect(varModuleDesc,['Holiday Maintenance [Add]','Holiday Maintenance [Edit]','Holiday Maintenance [Delete]']) of
          0:cmdAdd.Enabled := TRUE;
          1:cmdSave.Enabled := TRUE;
          2:cmdCancel.Enabled := TRUE;

        end;
      end;

      dsAccess.Next;

    end;
   end;

   InsertToLogFile(sTranDate, sUserID, 'Holiday Maintenance', 'Load', 'dtaHoliday_details', '');

   
   DecodeDate(Now, wYear, wMonth, wDay);

   if wDay <= 15 then
      dtDate1.Date := EncodeDateTime(wYear, wMonth, 1, 0, 0, 0, 0)
   else
      dtDate1.Date := EncodeDateTime(wYear, wMonth, 16, 0, 0, 0, 0);

   TfrmHolidayMaintenance.dtDate1Change;
end;

function TfrmHolidayMaintenance.StringToCaseSelect(Selector : string; CaseList: array of string): Integer;
var cnt: integer;
begin
   Result:=-1;
   for cnt:=0 to Length(CaseList)-1 do
begin
     if CompareText(Selector, CaseList[cnt]) = 0 then
     begin
       Result:=cnt;
       Break;
     end;
   end;
end;

