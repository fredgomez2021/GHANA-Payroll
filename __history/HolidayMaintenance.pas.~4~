           + chr(39) + tUserId + chr(39) + ', '
           + chr(39) + tModuleDesc + chr(39) + ', '
           + chr(39) + tCommand + chr(39) + ', '
           + chr(39) + tTableName + chr(39) + ', '
           + chr(39) + tFieldName + chr(39) + ', '
           + chr(39) + tNewVal + Chr(39) +
           ')';
  ADOConnection1.Execute(SQL);
end;

