  SQL: String;
begin
  tUserId := IntToStr(gUser_ID);

  SQL := 'INSERT INTO dtaLogFile '
           + ' ( Tran_Date, User_id, Module_Desc, Command, Table_Name, Field_Name, New_Value ) '
           + 'VALUES ( '
