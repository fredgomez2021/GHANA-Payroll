{$R *.dfm}
 function IsDate(str: string): Boolean;
var
  dt: TDateTime;
begin
  Result := True;
  try
    dt := StrToDate(str);
  except
    Result := False;
  end;
end;

procedure TfrmHolidayMaintenance.dtDate1Change(Sender: TObject);
var
  dt: TDateTime;
  myYear, myMonth, myDay : Word;
begin
    dbgrid1.Visible := true;
    DecodeDate(dtDate1.Date, myYear, myMonth, myDay);
  if(DayOfTheMonth(dtDate1.Date))=1 then
    dt := EncodeDate( myYear, myMonth, 15)
  else
  begin
      dt := EndOfAMonth( myYear, myMonth );
      DecodeDate( dt, myYear, myMonth, myDay );
      dt := EncodeDate( myYear, myMonth, myDay );
  end;
  dtDate2.Date := dt;
  dtDate2.Refresh;

  //Grid_Load;
end;

