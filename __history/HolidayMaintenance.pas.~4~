procedure TfrmHolidayMaintenance.LoadHolidayTypes();
begin
  dsModule.Close;
  dsModule.CommandText := 'SELECT * FROM dtaHoliday_Type ORDER BY Holiday_Type';
  dsModule.Connection := ADOConnection1;
  dsModule.Active := TRUE;

  cmbHolidayType.Clear;
  if dsModule.RecordCount > 0 then
  begin
    dsModule.First;
    while not dsModule.Eof do
    begin
      cmbHolidayType.AddItem (dsModule.FieldByName('Holiday_Type').AsString, cmbHolidayType);

      dsModule.Next;
    end;
  end;
end;


