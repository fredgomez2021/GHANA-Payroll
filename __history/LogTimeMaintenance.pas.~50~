        begin
          varDate := DateToStr(dtDate.Date);
          ADODataSet1.CommandText := 'SELECT dtaTime_Detail.Employee_PIN, dtaEmployees.Employee_Name, Actual_In, Actual_Out, Sched_Out, Regular_Hours, OT, Remarks, AuthorizeOT, Branch_Code, TIME_ID ' +
