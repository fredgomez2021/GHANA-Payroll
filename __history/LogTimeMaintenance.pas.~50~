        GotoBookmark(Pointer(GridTime.SelectedRows.Items[i]));

        sString1 := ADODataSet1.CommandText;

        //log file variables
//        varDate := DateToStr(Date);
//        varPIN1 := txtPIN.Text;

//        varCommand := 'Delete';
//        varFieldName := 'All';
//        varPrevValue := txtTimein.Text + ' - ' + txtTimeout.Text;
//        varNewValue := '';

//        InsertToLogFile(varDate, ActiveUserId, varModule, varCommand, varTable, '', varFieldName, varPIN1, varPrevValue, varNewValue);
        Delete_log;

        if dtDate.Enabled = TRUE then
        begin
          sString := DateToStr(ADODataSet1.FieldByName('Actual_In').AsDateTime);
          sString2 := ADODataSet1.FieldByName('Employee_PIN').AsString;
          sString3 := ADODataSet1.FieldByName('Actual_In').AsString;

          ADOConnection1.Execute('UPDATE dtaTime_Detail SET IsDeleted = 1 WHERE Work_Date = ' + Chr(39) + sString + Chr(39) + ' AND Employee_PIN = ' + sString2 + ' AND Actual_In = ' + Chr(39) + sString3 + Chr(39));

