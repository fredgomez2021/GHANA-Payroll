    if ADODataSet2.RecordCount > 0 then
    begin
      if ((ADODataSet2.FieldByName('Job_position_code').AsString <> 'ADMIN ASST') AND (ADODataSet2.FieldByName('Job_position_code').AsString <> 'F.ANALYST')) then
      begin
        btnAdd.Enabled := FALSE;
        btnEdit.Enabled := FALSE;
        Button1.Enabled := FALSE;
      end;
    end;

    ADODataSet2.Close;

end;

procedure TfrmLogTimeMaintenance.btnExcessOTClick(Sender: TObject);
var

  oXL, oWB, oSheet : variant;

  sqlStr : string;

  varLimit : string;
  row : integer;
begin

  oXL := CreateOleObject('Excel.Application');
  oWB := oxl.workbooks.add();

  oWB.Worksheets.Add();
  oWB.Worksheets.Add();

  oSheet := owb.Sheets[1];
  oSheet.Name := 'Excess overtime';


  if (StrToFloat(txtLimit.Text) > 0) then
  begin

    varLimit := trim(txtLimit.Text);

    row := 1;

    oSheet.Cells[row, 1] := 'EMPLOYEES WITH EXCESS OVERTIME';

    row := row + 1;
    oSheet.Cells[row, 1] := 'Period: ' + d1 + ' - ' + d2;

    row := row + 2;
    oSheet.Cells[row, 1] := 'project';
    oSheet.Cells[row, 2] := 'pin';
    oSheet.Cells[row, 3] := 'job position';
    oSheet.Cells[row, 4] := 'work date';
    oSheet.Cells[row, 5] := 'actual in';
    oSheet.Cells[row, 6] := 'actual out';
    oSheet.Cells[row, 7] := 'overtime';

    oSheet.Range['A1'].ColumnWidth := 18;
    oSheet.Range['B2'].ColumnWidth := 8;
    oSheet.Range['C3'].ColumnWidth := 12;
    oSheet.Range['D4'].ColumnWidth := 14;
    oSheet.Range['E5'].ColumnWidth := 20;
    oSheet.Range['F6'].ColumnWidth := 20;
    oSheet.Range['G7'].ColumnWidth := 8;


    oSheet.Range['A1:G4'].Font.Bold := true;
    //oSheet.Range['A1:G4'].HorizontalAlignment := HorizontalAlignment.Center;

    row := row + 1;
    oSheet.Range['A' + IntToStr(row) + ':A' + IntToStr(row)].RowHeight := 3;




    row := row + 1;


    sqlStr := 'SELECT b.employee_pin, b.primary_task_id, b.emp_loc, b.job_position_code, a.* ' +
      'FROM dtaTime_Summary a LEFT OUTER JOIN dtaEmployees b ON a.employee_pin = b.employee_pin ' +
      'WHERE b.emp_status = ''active'' AND (b.job_position_code = ''keyer'' OR b.job_position_code = ''qa'') ' +
      'AND a.work_date BETWEEN ' + d1 + ' AND ' + d2 + ' AND a.ot > ' + varLimit +
      ' ORDER BY b.primary_task_id, a.employee_pin, a.work_date';

    dsOvertime.Connection := ADOConnection1;
    dsOvertime.CommandText := sqlStr;
    dsOvertime.Open;

    if (dsOvertime.RecordCount > 0) then
    begin

      dsOvertime.First;

      repeat

        with dsOvertime do
        begin

          oSheet.Cells[row, 1] := FieldByName('primary_task_id').AsString;
          oSheet.Cells[row, 2] := FieldByName('employee_pin').AsString;
          oSheet.Cells[row, 3] := FieldByName('job_position_code').AsString;
          oSheet.Cells[row, 4] := FieldByName('work_date').AsString;
          oSheet.Cells[row, 5] := Chr(39) + FieldByName('actual_in').AsString;
          oSheet.Cells[row, 6] := Chr(39) + FieldByName('actual_out').AsString;

          oSheet.Cells[row, 7] := FieldByName('ot').AsString;
          oSheet.Range['G' + IntToStr(row)].Font.Color := clRED;

        //end with
        end;

        dsOvertime.Next;
        row := row + 1;

      //end do while
      until dsOvertime.Eof

    //end if
    end;

    oSheet.Cells[row, 1] := '***nothing follows***';

    row := row + 2;
    oSheet.Cells[row, 1] := IntToStr(dsOvertime.RecordCount) + ' record(s)';
    oSheet.Range['A' + IntToStr(row)].Font.Bold := true;

    dsOvertime.Close;

    oXL.Visible := true;

  end;
end;

procedure TfrmLogTimeMaintenance.InsertToLogFile(vDate, vUser, vModule, vCommand, vTable, vPIN: String);
begin

  dsLogFile.Close;
  dsLogFile.CommandText := 'SELECT * FROM dtaLogFile';
  dsLogFile.Active := TRUE;

  with dsLogFile do
  begin
    Insert;
      FieldByName('Tran_Date').AsString := vDate;
      FieldByName('User_Id').AsString := vUser;
      FieldByName('Module_Desc').AsString := vModule;
      FieldByName('Command').AsString := vCommand;
      FieldByName('Table_Name').AsString := vTable;
      FieldByName('Employee_PIN').AsString := vPIN;
      FieldByName('Remarks').AsString := 'Module log';
    Post;
  end;
end;

procedure TfrmLogTimeMaintenance.btnFinalizeEditingClick(Sender: TObject);
begin
  // This is to ...
  //update dtaTime_Summary table
  if (cmbMonth.Text <> '') AND (cmbBranch.Text <> '') then
  begin
    days1 := 0;
    days2 := 0;

