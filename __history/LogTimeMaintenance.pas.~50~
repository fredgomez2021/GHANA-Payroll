            lblAuthorized.Caption := 'Authorized'
          else
            lblAuthorized.Caption := '';

          txtOT.Text := ADODataSet2.FieldByName('OT').AsString;
          txtTimeInSummary.Text := ADODataSet2.FieldByName('Actual_In').AsString;
          txtTimeOutSummary.Text := ADODataSet2.FieldByName('Actual_Out').AsString;

        end
