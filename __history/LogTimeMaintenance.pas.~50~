    if ADODataSet2.RecordCount > 0 then
    begin
      //if ADODataSet2.FieldByName('tStatus').Value = TRUE then
      if StrToDate(txtWorkDate.Text) > ADODataSet2.FieldByName('tTo').Value then
      begin
        {ShowMessage('Editing of time detail for this payroll period is currently locked!');

        btnAdd.Enabled := FALSE;
        btnEdit.Enabled := FALSE;
        Button1.Enabled := FALSE;}
      end
      else
      begin
        if (StrToDate(txtWorkDate.Text) < ADODataSet2.FieldByName('tFrom').Value) or (ADODataSet2.FieldByName('tStatus').Value = TRUE) then
