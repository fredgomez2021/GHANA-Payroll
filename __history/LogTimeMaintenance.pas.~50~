procedure TfrmLogTimeMaintenance.GridTimeCellClick(Column: TColumn);
var
  i : Integer;
  varOT : String;
  tPIN : String;
begin
  if GridTime.SelectedRows.Count > 0 then
  begin
    with GridTime.DataSource.DataSet do
    begin
      for i := 0 to GridTime.SelectedRows.Count-1 do
      begin
        GotoBookmark(Pointer(GridTime.SelectedRows.Items[i]));

        vTIME_ID := ADODataSet1.FieldByName('TIME_ID').AsString;

        if optWorkingDate.Checked = TRUE then
        begin
          txtWorkDate.Text := DateToStr(dtDate.Date);
          txtPIN.Text := ADODataSet1.FieldByName('Employee_PIN').AsString;

          tPIN := Trim(txtPIN.Text);

        end
        else if optEmpPIN.Checked = TRUE then
        begin
          txtWorkDate.Text := ADODataSet1.FieldByName('Work_Date').AsString;
          txtPIN.Text := varPIN;

          tPIN := Trim(txtPIN.Text);
        end;

        txtTimeIn.Text := ADODataSet1.FieldByName('Actual_In').AsString;
        txtTimeOut.Text := ADODataSet1.FieldByName('Actual_Out').AsString;
        txtTimeInterval.Text := ADODataSet1.FieldByName('Regular_Hours').AsString;


        //check dtaTime_Summary
        ADODataSet2.Close;
        ADODataSet2.CommandText := 'SELECT Actual_In, Actual_Out, OT, AuthorizeOT ' +
          'FROM dtaTime_Summary ' +
          'WHERE Work_Date = ' +
          chr(39) + txtWorkDate.Text + chr(39) + ' AND Employee_PIN = ''' + tPIN + '''';
        ADODataSet2.Active := TRUE;

        if ADODataSet2.RecordCount > 0 then
        begin
          varOT := Trim(ADODataSet2.FieldByName('AuthorizeOT').AsString);

          if varOT = 'Yes' then
            lblAuthorized.Caption := 'Authorized'
          else
            lblAuthorized.Caption := '';

          txtOT.Text := ADODataSet2.FieldByName('OT').AsString;
          txtTimeInSummary.Text := ADODataSet2.FieldByName('Actual_In').AsString;
          txtTimeOutSummary.Text := ADODataSet2.FieldByName('Actual_Out').AsString;

        end
        else
        begin
          txtOT.Text := '';
          txtTimeInSummary.Text := '';
          txtTimeOutSummary.Text := '';

          lblAuthorized.Caption := '';
        end;

      end;
    end;
    btnAdd.Enabled := TRUE;
    btnEdit.Enabled := TRUE;
    Button1.Enabled := TRUE;


    ADODataSet2.Close;
    ADODataSet2.CommandText := 'SELECT * FROM dtaTimeSecurity';
    ADODataSet2.Active := TRUE;

    if ADODataSet2.RecordCount > 0 then
    begin
      //if ADODataSet2.FieldByName('tStatus').Value = TRUE then
      if StrToDate(txtWorkDate.Text) > ADODataSet2.FieldByName('tTo').Value then
      begin
        {ShowMessage('Editing of time detail for this payroll period is currently locked!');

        btnAdd.Enabled := FALSE;
        btnEdit.Enabled := FALSE;
        Button1.Enabled := FALSE;    }
      end
      else
      begin
        if (StrToDate(txtWorkDate.Text) < ADODataSet2.FieldByName('tFrom').Value) or (ADODataSet2.FieldByName('tStatus').Value = TRUE) then
        begin
          ShowMessage('Editing of previous time detail is strictly prohibited after payroll process!');

          btnAdd.Enabled := FALSE;
          btnEdit.Enabled := FALSE;
          Button1.Enabled := FALSE;
        end;
      end;
    end;

    ADODataSet2.Close;

    {ADODataSet2.CommandText := 'SELECT * FROM vwUsers WHERE username = ''' + gUser + '''';
    ADODataSet2.Open;

    if ADODataSet2.RecordCount > 0 then
    begin
      if ((ADODataSet2.FieldByName('Job_position_code').AsString <> 'ADMIN ASST')
        and (ADODataSet2.FieldByName('Job_position_code').AsString <> 'ACCTNG ASST')) then
      begin
        btnAdd.Enabled := FALSE;
        btnEdit.Enabled := FALSE;
        Button1.Enabled := FALSE;
      end;
    end;

    ADODataSet2.Close;
                     }
  end;
end;

procedure TfrmLogTimeMaintenance.btnShowClick(Sender: TObject);
var
  sEmpPrimaryTaskId : string;
begin
  // get employee primary task id
  ADODataSet1.Close;
  ADODataSet1.Connection := ADOConnection1;
  ADODataSet1.CommandText := 'SELECT TOP 1 ISNULL(Primary_Task_ID,'''') AS Primary_Task_ID ' +
    'FROM dtaEmployees ' +
    'WHERE Employee_PIN = ''' + txtEmpPIN.Text + ''' ';
  ADODataSet1.Active := TRUE;

  sEmpPrimaryTaskId := ADODataSet1.FieldByName('Primary_Task_ID').AsString;
  if (sEmpPrimaryTaskId <> '') then
  begin
    // check if user have access to this primary task id / project
    ADODataSet1.Close;
    ADODataSet1.Connection := ADOConnection1;
    ADODataSet1.CommandText := 'SELECT TOP 1 * ' +
      'FROM dtaUsers_ProjectAccess ' +
      'WHERE Primary_Task_ID = ''' + sEmpPrimaryTaskId + ''' ' +
      'AND UserName = ''' + txtUser.Text + ''' ' +
      'AND ISNULL(Deleted,0) = 0';
    ADODataSet1.Active := TRUE;
    if (ADODataSet1.RecordCount > 0) then
    begin
      Display_DTR;

      btnAdd.Enabled := true;
    end
    else
    begin

      ADODataSet1.Close;
      
      ShowMessage('You do not have access to modify the DTR of this employee.  Please contact your immediate Supervisor.');
    end;
  end
  else
  begin

    ADODataSet1.Close;
    
    ShowMessage('Employee does not have a Project assigned.  Please contact your immediate Supervisor.');
  end;
end;

