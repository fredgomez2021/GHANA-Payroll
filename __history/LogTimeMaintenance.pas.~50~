          ADOConnection1.Execute('UPDATE dtaTime_Detail SET IsDeleted = 1 WHERE Work_Date = ' + Chr(39) + sString + Chr(39) + ' AND Time_ID = ' + Chr(39) + tID + Chr(39));

          //ADOConnection1.Execute('DELETE FROM dtaTime_Detail WHERE Work_Date = ' + Chr(39) + sString + Chr(39) + ' AND Time_ID = ' + Chr(39) + tID + Chr(39));
